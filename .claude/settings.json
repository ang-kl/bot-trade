{
  "permissions": {
    "allow": [
      "mcp__Railway__redeploy",
      "mcp__Railway__update-service",
      "mcp__Railway__get-logs",
      "mcp__Railway__list-deployments",
      "mcp__Railway__list-services",
      "mcp__Railway__list-variables",
      "mcp__Railway__get-service-config",
      "mcp__Railway__get-service-metrics",
      "mcp__Railway__get-status"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/install-stop-hook.sh\"",
            "timeout": 10,
            "statusMessage": "Installing stop hook"
          }
        ]
      }
    ]
  }
}
